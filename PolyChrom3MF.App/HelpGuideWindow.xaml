<Window x:Class="PolyChrom3MF.App.HelpGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guide de PolyChrom 3MF"
        Width="900"
        Height="680"
        MinWidth="720"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="#20242B"
        Foreground="White">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="GUIDE DES FONCTIONS" FontSize="25" FontWeight="Bold"/>
      <TextBlock Text="Tout ce que vous pouvez réaliser avec PolyChrom 3MF." Foreground="#C2CAD6" Margin="0,4,0,0"/>
    </StackPanel>
    <TabControl Grid.Row="1" Background="#2B313C" BorderBrush="#566277">
      <TabItem Header="Démarrer"><ScrollViewer><StackPanel Margin="20" TextElement.Foreground="#E2E7EF">
        <TextBlock Text="Importer et préparer un modèle" FontSize="20" FontWeight="Bold"/>
        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22">Importez un fichier 3MF ou STL depuis Fichier, la barre d’outils ou par glisser-déposer. Les assemblages et transformations contenus dans les fichiers 3MF sont reconstruits automatiquement. Aucun plafond arbitraire de triangles n’est imposé : la capacité dépend de la mémoire disponible sur la machine.</TextBlock>
        <TextBlock Text="Choisissez ensuite le nombre de couleurs utilisables, de 2 à 32. Le bouton Recentrer affiche toute la figurine ; les vues Iso, Face et Dessus facilitent son inspection." TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>
        <TextBlock Text="Souris : clic gauche pour tourner, clic droit pour déplacer, molette pour zoomer sous le curseur." TextWrapping="Wrap" Margin="0,12,0,0" FontWeight="SemiBold"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Calques et précision"><ScrollViewer><StackPanel Margin="20" TextElement.Foreground="#E2E7EF">
        <TextBlock Text="Travailler sans détruire le modèle" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Chaque peinture, sélection ou effet peut être conservé dans un calque. Les calques peuvent être masqués, verrouillés, renommés, dupliqués, réordonnés ou fusionnés. L’opacité ne concerne que l’aperçu : l’export conserve des couleurs de filament franches." TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22"/>
        <TextBlock Text="La galerie .polystyle partage les palettes, les types de calques et le profil d’impression. Le projet .poly3mf reste le format complet qui inclut aussi la géométrie et toutes les sélections." TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Propositions"><ScrollViewer><StackPanel Margin="20" TextElement.Foreground="#E2E7EF">
        <TextBlock Text="Créer des styles multicolores" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Le logiciel génère quatre propositions différentes comportant de 2 à 32 couleurs. Activez les motifs fun pour obtenir des dégradés, camouflages, doubles personnalités et styles graffiti. Faites un clic droit sur une pastille de couleur pour la remplacer individuellement." TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22"/>
        <TextBlock Text="Régénérer fabrique quatre nouvelles variantes. Vous pouvez limiter les propositions à vos couleurs de filament et modifier une couleur ou un élément individuellement." TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Coloration manuelle"><ScrollViewer><StackPanel Margin="20" TextElement.Foreground="#E2E7EF">
        <TextBlock Text="Colorier exactement les zones voulues" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Activez Sélectionner des zones. L’outil Face par face sélectionne un triangle précis. L’outil Pinceau fluide permet de maintenir le clic gauche et de dessiner sur la surface avec cinq tailles." TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22"/>
        <TextBlock Text="Dans ce mode, utilisez le clic droit pour faire tourner la figurine et la molette pour zoomer. Choisissez une couleur, sélectionnez une ou plusieurs zones, puis cliquez sur Appliquer la couleur." TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Logos et images"><ScrollViewer><StackPanel Margin="20" TextElement.Foreground="#E2E7EF">
        <TextBlock Text="Placer un logo sans altérer le fond" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Importez une image PNG, JPG, JPEG, WebP ou SVG. Le premier écran permet de conserver la transparence, de retirer automatiquement le fond relié aux bords, de supprimer une couleur dominante ou de corriger le masque avec la gomme et l’outil de restauration." TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22"/>
        <TextBlock Text="Dans l’atelier 3D, cliquez sur Placer sur la pièce puis sur la surface voulue. Réglez la taille, la largeur, la hauteur, la rotation, l’inclinaison, les miroirs, le relief et la projection plane, cylindrique ou adaptée à la courbure. L’aperçu est recalculé depuis une copie intacte du fond." TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>
        <TextBlock Text="Les copies horizontales, verticales ou circulaires sont des logos indépendants. Après validation, sélectionnez un logo dans le panneau droit pour le modifier, le dupliquer à côté, le masquer ou le supprimer. Enregistrer projet embarque l’image et toutes ses positions ; Exporter 3MF écrit les couleurs finales pour les slicers." TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Projets et partage"><ScrollViewer><StackPanel Margin="20" TextElement.Foreground="#E2E7EF">
        <TextBlock Text="Sauvegarder et partager" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Enregistrer projet crée un fichier .poly3mf portable contenant le modèle, les propositions, les affectations par triangle et la vue. Un autre utilisateur de PolyChrom 3MF peut l’ouvrir et retrouver le même travail." TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22"/>
        <TextBlock Text="Exporter 3MF produit le fichier coloré final. La géométrie n’est pas découpée : les couleurs imprimables sont inscrites dans le document 3MF." TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Slicers et mises à jour"><ScrollViewer><StackPanel Margin="20" TextElement.Foreground="#E2E7EF">
        <TextBlock Text="Continuer vers l’impression" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="PolyChrom détecte les slicers installés, notamment PrusaSlicer, OrcaSlicer, Bambu Studio, Cura et Snapmaker Orca. Choisissez votre slicer préféré dans Paramètres, puis ouvrez-y directement le modèle exporté." TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22"/>
        <TextBlock Text="Avant l’export, l’assistant de profil lit les profils réellement installés. Confirmez le slicer, l’imprimante, le processus, la buse, les emplacements et le matériau de chaque filament. Le profil peut être mémorisé comme valeur par défaut ; PolyChrom remplace alors intégralement les anciennes métadonnées machine du fichier source afin qu’un projet Bambu ne soit jamais rouvert par erreur avec une X1 Carbon lorsqu’il est destiné à une Snapmaker ou à une Prusa." TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>
        <TextBlock Text="La recherche de mise à jour vérifie les versions publiées, télécharge l’installateur, contrôle son empreinte SHA-256 et redémarre l’application. Après une mise à jour, la fenêtre Nouveautés résume les ajouts et corrections." TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Button Grid.Row="2" Content="Fermer" Click="Close_Click" HorizontalAlignment="Right" Width="130" MinHeight="40" Margin="0,16,0,0" IsDefault="True"/>
  </Grid>
</Window>
