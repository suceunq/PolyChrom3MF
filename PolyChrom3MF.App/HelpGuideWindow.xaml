<Window x:Class="PolyChrom3MF.App.HelpGuideWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Guide de PolyChrom 3MF"
        Width="900"
        Height="680"
        MinWidth="720"
        MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="#20242B"
        Foreground="White">
  <Grid Margin="22">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="0,0,0,16">
      <TextBlock Text="GUIDE DES FONCTIONS" FontSize="25" FontWeight="Bold"/>
      <TextBlock Text="Tout ce que vous pouvez réaliser avec PolyChrom 3MF." Foreground="#C2CAD6" Margin="0,4,0,0"/>
    </StackPanel>
    <TabControl Grid.Row="1" Background="#2B313C" BorderBrush="#566277">
      <TabItem Header="Démarrer"><ScrollViewer><StackPanel Margin="20" TextElement.Foreground="#E2E7EF">
        <TextBlock Text="Importer et préparer un modèle" FontSize="20" FontWeight="Bold"/>
        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22">Importez un fichier 3MF ou STL depuis Fichier, la barre d’outils ou par glisser-déposer. Les assemblages et transformations contenus dans les fichiers 3MF sont reconstruits automatiquement. Aucun plafond arbitraire de triangles n’est imposé : la capacité dépend de la mémoire disponible sur la machine.</TextBlock>
        <TextBlock Text="Choisissez ensuite le nombre de couleurs utilisables, de 4 à 32. Le bouton Recentrer affiche toute la figurine ; les vues Iso, Face et Dessus facilitent son inspection." TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>
        <TextBlock Text="Souris : clic gauche pour tourner, clic droit pour déplacer, molette pour zoomer sous le curseur." TextWrapping="Wrap" Margin="0,12,0,0" FontWeight="SemiBold"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Propositions"><ScrollViewer><StackPanel Margin="20" TextElement.Foreground="#E2E7EF">
        <TextBlock Text="Créer des styles multicolores" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Le logiciel génère quatre propositions différentes comportant au minimum quatre couleurs. Activez les motifs fun pour obtenir des dégradés, camouflages, doubles personnalités et styles graffiti." TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22"/>
        <TextBlock Text="Régénérer fabrique quatre nouvelles variantes. Vous pouvez limiter les propositions à vos couleurs de filament et modifier une couleur ou un élément individuellement." TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Coloration manuelle"><ScrollViewer><StackPanel Margin="20" TextElement.Foreground="#E2E7EF">
        <TextBlock Text="Colorier exactement les zones voulues" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Activez Sélectionner des zones. L’outil Face par face sélectionne un triangle précis. L’outil Pinceau fluide permet de maintenir le clic gauche et de dessiner sur la surface avec cinq tailles." TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22"/>
        <TextBlock Text="Dans ce mode, utilisez le clic droit pour faire tourner la figurine et la molette pour zoomer. Choisissez une couleur, sélectionnez une ou plusieurs zones, puis cliquez sur Appliquer la couleur." TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Images et motifs"><ScrollViewer><StackPanel Margin="20" TextElement.Foreground="#E2E7EF">
        <TextBlock Text="Appliquer une image PNG ou JPG" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Importez une image PNG, JPG ou JPEG comme motif. Pour une photo JPG, vous pouvez conserver le fond ou demander sa suppression automatique locale avec une tolérance réglable." TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22"/>
        <TextBlock Text="Choisissez la cible, la projection, la taille, la rotation et les décalages. Quatre projections peuvent être créées : frontale, cylindrique, répétée et triplanaire. Les couleurs de l’image sont converties vers les couleurs de filament disponibles." TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>
        <TextBlock Text="Conseil : un sujet contrasté sur un fond uni donne la suppression de fond la plus propre." TextWrapping="Wrap" Margin="0,12,0,0" FontWeight="SemiBold"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Projets et partage"><ScrollViewer><StackPanel Margin="20" TextElement.Foreground="#E2E7EF">
        <TextBlock Text="Sauvegarder et partager" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="Enregistrer projet crée un fichier .poly3mf portable contenant le modèle, les propositions, les affectations par triangle, la vue et le motif image. Un autre utilisateur de PolyChrom 3MF peut l’ouvrir et retrouver le même travail." TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22"/>
        <TextBlock Text="Exporter 3MF produit le fichier coloré final. La géométrie n’est pas découpée : les couleurs imprimables sont inscrites dans le document 3MF." TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>
      </StackPanel></ScrollViewer></TabItem>
      <TabItem Header="Slicers et mises à jour"><ScrollViewer><StackPanel Margin="20" TextElement.Foreground="#E2E7EF">
        <TextBlock Text="Continuer vers l’impression" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="PolyChrom détecte les slicers installés, notamment PrusaSlicer, OrcaSlicer, Bambu Studio, Cura et Snapmaker Orca. Choisissez votre slicer préféré dans Paramètres, puis ouvrez-y directement le modèle exporté." TextWrapping="Wrap" Margin="0,10,0,0" LineHeight="22"/>
        <TextBlock Text="La recherche de mise à jour vérifie les versions publiées, télécharge l’installateur, contrôle son empreinte SHA-256 et redémarre l’application. Après une mise à jour, la fenêtre Nouveautés résume les ajouts et corrections." TextWrapping="Wrap" Margin="0,12,0,0" LineHeight="22"/>
      </StackPanel></ScrollViewer></TabItem>
    </TabControl>
    <Button Grid.Row="2" Content="Fermer" Click="Close_Click" HorizontalAlignment="Right" Width="130" MinHeight="40" Margin="0,16,0,0" IsDefault="True"/>
  </Grid>
</Window>
