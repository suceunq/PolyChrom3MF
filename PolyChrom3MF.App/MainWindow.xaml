<Window x:Class="PolyChrom3MF.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PolyChrom 3MF" Height="850" Width="1440" MinHeight="650" MinWidth="1050"
        Background="{DynamicResource AppBackground}" Foreground="{DynamicResource PrimaryText}" AllowDrop="True" Drop="Window_Drop"
        Closing="Window_Closing" KeyDown="Window_KeyDown">
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" Background="{x:Static SystemColors.MenuBrush}" Foreground="#202020">
      <MenuItem Header="_Fichier">
        <MenuItem Header="_Mode débutant…" Click="BeginnerMode_Click"/>
        <Separator/>
        <MenuItem Header="_Nouveau" Click="New_Click" InputGestureText="Ctrl+N"/>
        <MenuItem Header="_Ouvrir un modèle 3MF ou STL…" Click="Import_Click" InputGestureText="Ctrl+O"/>
        <MenuItem Header="Ouvrir un _projet…" Click="OpenProject_Click"/>
        <MenuItem Header="_Enregistrer le projet…" Click="SaveProject_Click" InputGestureText="Ctrl+S"/>
        <Separator/><MenuItem Header="_Exporter en 3MF…" Click="Export_Click" InputGestureText="Ctrl+E"/>
        <Separator/><MenuItem Header="_Quitter" Click="Quit_Click"/>
      </MenuItem>
      <MenuItem Header="_Édition"><MenuItem Header="_Annuler" Click="Undo_Click" InputGestureText="Ctrl+Z"/><MenuItem Header="_Rétablir" Click="Redo_Click" InputGestureText="Ctrl+Y"/><Separator/><MenuItem Header="_Paramètres…" Click="Settings_Click"/></MenuItem>
      <MenuItem Header="_Coloration"><MenuItem x:Name="PaintModeMenu" Header="_Sélectionner des zones" IsCheckable="True" Checked="PaintMode_Changed" Unchecked="PaintMode_Changed"/><MenuItem Header="Appliquer la couleur aux zones" Click="ApplyPaintSelection_Click"/><MenuItem Header="Effacer la sélection" Click="ClearPaintSelection_Click"/><Separator/><MenuItem Header="Galerie de styles…" Click="StyleGallery_Click"/><MenuItem Header="Enregistrer le style actuel…" Click="SaveStyle_Click"/></MenuItem>
      <MenuItem Header="_Images et logos"><MenuItem Header="_Importer un logo ou une image…" Click="ImportPattern_Click"/><MenuItem Header="_Retirer tous les logos" Click="RemovePattern_Click"/></MenuItem>
      <MenuItem Header="_Affichage"><MenuItem Header="Isométrique" Click="ViewIso_Click"/><MenuItem Header="Face" Click="ViewFront_Click"/><MenuItem Header="Arrière" Click="ViewBack_Click"/><MenuItem Header="Gauche" Click="ViewLeft_Click"/><MenuItem Header="Droite" Click="ViewRight_Click"/><MenuItem Header="Dessus" Click="ViewTop_Click"/><MenuItem Header="Dessous" Click="ViewBottom_Click"/><Separator/><MenuItem x:Name="PlateMenuItem" Header="Afficher le plateau" IsCheckable="True" Click="ToggleGrid_Click"/><MenuItem x:Name="InertiaMenuItem" Header="Inertie de navigation" IsCheckable="True" Click="ToggleInertia_Click"/><MenuItem Header="Perspective/orthographique" Click="TogglePerspective_Click"/></MenuItem>
      <MenuItem Header="_Aide"><MenuItem Header="Guide des fonctions" Click="HelpGuide_Click"/><MenuItem Header="Assistant de bienvenue" Click="Welcome_Click"/><MenuItem Header="Nouveautés de cette version" Click="WhatsNew_Click"/><MenuItem Header="Soutenir le projet via PayPal" Click="Donate_Click"/><MenuItem Header="Rechercher une mise à jour" Click="Update_Click"/><Separator/><MenuItem Header="À propos" Click="About_Click"/></MenuItem>
    </Menu>

    <ToolBar x:Name="MainToolbar" DockPanel.Dock="Top" Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource PrimaryText}">
      <Button Click="BeginnerMode_Click">Mode débutant</Button><Button Click="Import_Click" ToolTip="Ouvrir un fichier 3MF ou STL">Importer 3MF/STL</Button><Button Click="SaveProject_Click">Enregistrer projet</Button><Button Click="Export_Click">Exporter 3MF</Button><Button x:Name="OpenSlicerButton" Click="OpenPreferredSlicer_Click" IsEnabled="False">Ouvrir dans mon slicer</Button>
      <Separator/><Button Click="Undo_Click">Annuler</Button><Button Click="Redo_Click">Rétablir</Button><Separator/><Button Click="ImportPattern_Click">Importer logo/image</Button><Button Click="StyleGallery_Click">Galerie styles</Button><Button Click="ColorCount_Click">Nombre de couleurs</Button><Button Click="PrintAssistant_Click">Assistant impression</Button><Button Click="Regenerate_Click">Régénérer</Button><Button Click="Settings_Click">Paramètres</Button>
    </ToolBar>

    <StatusBar DockPanel.Dock="Bottom" Background="{DynamicResource PanelBackground}" Foreground="{DynamicResource PrimaryText}">
      <TextBlock x:Name="StatusText" Text="Prêt — importez un fichier 3MF ou STL." Margin="8,0"/><Separator/><TextBlock x:Name="StatsText"/>
    </StatusBar>

    <Grid x:Name="WorkspaceGrid" Margin="12">
      <Grid.ColumnDefinitions><ColumnDefinition x:Name="LeftColumn" Width="280"/><ColumnDefinition Width="*"/><ColumnDefinition x:Name="RightColumn" Width="370"/></Grid.ColumnDefinitions>

      <Border x:Name="LeftPanel" Grid.Column="0" Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,10,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Bottom">
            <Separator Margin="0,12"/><TextBlock Text="COULEUR DE L’ÉLÉMENT" FontWeight="Bold"/>
            <ComboBox x:Name="ObjectColorCombo" Margin="0,8,0,5" DisplayMemberPath="Label" SelectionChanged="ObjectColorCombo_SelectionChanged"/>
            <Button Click="EditSelectedColor_Click" Content="Modifier la couleur sélectionnée…"/>
            <DockPanel Margin="0,6,0,0"><Button DockPanel.Dock="Right" Click="ApplyHex_Click" Content="Appliquer"/><TextBox x:Name="HexColorText" Text="#FFFFFF" Margin="0,0,6,0" ToolTip="Code couleur hexadécimal, par exemple #FF8800"/></DockPanel>
          </StackPanel>
          <StackPanel>
            <TextBlock Text="MODÈLE" FontWeight="Bold" FontSize="16"/>
            <TextBlock x:Name="FileText" Margin="0,12,0,4" Text="Aucun fichier chargé" TextWrapping="Wrap"/>
            <TextBlock x:Name="InfoText" Foreground="{DynamicResource SecondaryText}" TextWrapping="Wrap"/>
            <Separator Margin="0,16,0,12"/><TextBlock Text="OBJETS ET VOLUMES" FontWeight="Bold"/>
            <Border Background="#263C56" BorderBrush="#4FA3FF" BorderThickness="1" CornerRadius="5" Padding="7" Margin="0,8,0,0">
              <TextBlock x:Name="SelectedObjectText" Text="Aucun objet sélectionné" TextWrapping="Wrap" FontWeight="SemiBold" Foreground="#EAF4FF"/>
            </Border>
            <ListBox x:Name="ObjectsList" Margin="0,8,0,0" Height="350" SelectionChanged="ObjectsList_SelectionChanged"/>
          </StackPanel>
        </DockPanel>
      </Border>

      <Border x:Name="ViewerPanel" Grid.Column="1" Background="{DynamicResource ViewerBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="0,0,10,0">
        <Grid>
          <Viewport3D x:Name="Viewer" ClipToBounds="True" Focusable="True" MouseWheel="Viewer_MouseWheel" MouseDown="Viewer_MouseDown" MouseMove="Viewer_MouseMove" MouseUp="Viewer_MouseUp" MouseLeave="Viewer_MouseLeave" ToolTip="Toute la vue est interactive · gauche = orbite 360° · double-clic = pivot dynamique · droit = panoramique · molette = zoom sous le curseur"/>
          <ContentControl x:Name="GpuHost" Visibility="Collapsed"/>
          <Canvas IsHitTestVisible="False" Panel.ZIndex="15">
            <Polyline x:Name="PaintStrokePreview" Visibility="Collapsed" Stroke="#99FFD32D" StrokeThickness="16"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
            <Ellipse x:Name="PaintBrushCursor" Visibility="Collapsed" Stroke="#FFFFD32D" StrokeThickness="2" Fill="#22FFD32D"/>
          </Canvas>
          <Canvas x:Name="PatternGizmoCanvas" Visibility="Collapsed" Panel.ZIndex="16">
            <Border x:Name="PatternGizmo" Width="170" Height="170" BorderBrush="#FF42A5FF" BorderThickness="2"
                    Background="#080070C0" MouseLeftButtonDown="PatternGizmo_MoveDown" MouseMove="PatternGizmo_MouseMove"
                    MouseLeftButtonUp="PatternGizmo_MouseUp" MouseRightButtonUp="PatternGizmo_RightButtonUp">
              <Grid>
                <TextBlock Text="Glisser pour déplacer" Foreground="#FFFFFFFF" Background="#99000000"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Padding="6,3"/>
                <Ellipse Width="18" Height="18" Fill="#FFFFFFFF" Stroke="#FF1785D1" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-10,-10,0,0"
                         Tag="resize" MouseLeftButtonDown="PatternGizmo_HandleDown"/>
                <Ellipse Width="18" Height="18" Fill="#FFFFFFFF" Stroke="#FF1785D1" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-10,-10,0"
                         Tag="resize" MouseLeftButtonDown="PatternGizmo_HandleDown"/>
                <Ellipse Width="18" Height="18" Fill="#FFFFFFFF" Stroke="#FF1785D1" StrokeThickness="2" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-10,0,0,-10"
                         Tag="resize" MouseLeftButtonDown="PatternGizmo_HandleDown"/>
                <Ellipse Width="18" Height="18" Fill="#FFFFFFFF" Stroke="#FF1785D1" StrokeThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-10,-10"
                         Tag="resize" MouseLeftButtonDown="PatternGizmo_HandleDown"/>
                <Line X1="85" Y1="-34" X2="85" Y2="0" Stroke="#FF42A5FF" StrokeThickness="2"/>
                <Ellipse Width="22" Height="22" Fill="#FFFFC43D" Stroke="#FFFFFFFF" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-45,0,0"
                         Tag="rotate" MouseLeftButtonDown="PatternGizmo_HandleDown" ToolTip="Tourner le logo"/>
              </Grid>
            </Border>
            <Popup x:Name="PatternGizmoMenu" Placement="MousePoint" StaysOpen="False" AllowsTransparency="True">
              <Border Width="310" Padding="8" CornerRadius="7" Background="#FF202733" BorderBrush="#FF718096" BorderThickness="1">
                <StackPanel>
                  <TextBlock Text="LOGO SÉLECTIONNÉ" Foreground="#FFFFFFFF" FontWeight="Bold" Margin="5,2,5,7"/>
                  <Button Content="Dupliquer 2 fois" Tag="2" Click="PatternGizmo_Duplicate" HorizontalContentAlignment="Left"/>
                  <Button Content="Dupliquer 4 fois" Tag="4" Click="PatternGizmo_Duplicate" HorizontalContentAlignment="Left"/>
                  <Button Content="Dupliquer 8 fois" Tag="8" Click="PatternGizmo_Duplicate" HorizontalContentAlignment="Left"/>
                  <Button Content="Choisir le nombre de copies…" Tag="custom" Click="PatternGizmo_Duplicate" HorizontalContentAlignment="Left"/>
                  <Border Height="1" Background="#FF566277" Margin="4,7"/>
                  <CheckBox x:Name="PatternGizmoGroupMode" Content="Déplacer/redimensionner tout le groupe" Margin="4,3,4,5"/>
                  <TextBlock Text="Décochez cette option pour modifier seulement le logo sélectionné."
                             Foreground="#FFC2CAD6" TextWrapping="Wrap" Margin="5,0,5,3"/>
                </StackPanel>
              </Border>
            </Popup>
          </Canvas>
          <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" MaxWidth="250">
            <Button Click="ViewIso_Click" Content="Iso" Margin="2"/><Button Click="ViewFront_Click" Content="Face" Margin="2"/><Button Click="ViewTop_Click" Content="Dessus" Margin="2"/><Button Click="ToggleGrid_Click" Content="Plateau" Margin="2"/><Button Click="Fit_Click" Content="Recentrer" Margin="2"/>
          </WrapPanel>
          <Border x:Name="PatternTransformPanel" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="12,12,12,48" Padding="8" CornerRadius="8" Background="#E62B313C" BorderBrush="#58AFFF" BorderThickness="1">
            <StackPanel>
              <TextBlock Text="TRANSFORMER LE MOTIF DANS LA VUE 3D" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,5"/>
              <WrapPanel HorizontalAlignment="Center">
                <Button Tag="left" Click="PatternTransform_Click" Content="←"/><Button Tag="right" Click="PatternTransform_Click" Content="→"/><Button Tag="up" Click="PatternTransform_Click" Content="↑"/><Button Tag="down" Click="PatternTransform_Click" Content="↓"/>
                <Button Tag="rotateleft" Click="PatternTransform_Click" Content="↶"/><Button Tag="rotateright" Click="PatternTransform_Click" Content="↷"/>
                <Button Tag="smaller" Click="PatternTransform_Click" Content="− Taille"/><Button Tag="larger" Click="PatternTransform_Click" Content="+ Taille"/>
                <Button Tag="mirrorx" Click="PatternTransform_Click" Content="Miroir ↔"/><Button Tag="mirrory" Click="PatternTransform_Click" Content="Miroir ↕"/>
                <Button Tag="copy" Click="PatternTransform_Click" Content="+ Copie"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border x:Name="ActivityOverlay"
                  Panel.ZIndex="20"
                  Visibility="Collapsed"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Top"
                  Width="520"
                  MaxWidth="650"
                  Margin="16,72,16,0"
                  Padding="16,13"
                  CornerRadius="10"
                  Background="#F02B313C"
                  BorderBrush="#58AFFF"
                  BorderThickness="2">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="38"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border Width="30" Height="30" CornerRadius="15" Background="#187FD1" VerticalAlignment="Top">
                <TextBlock Text="●" Foreground="White" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <TextBlock Text="TRAITEMENT EN COURS" Foreground="#8EC8FF" FontSize="11" FontWeight="Bold"/>
                <TextBlock x:Name="ActivityText" Text="Traitement…" Foreground="White" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,3,0,9"/>
                <ProgressBar x:Name="ActivityProgress" Height="7" Minimum="0" Maximum="100" IsIndeterminate="True"/>
              </StackPanel>
            </Grid>
          </Border>
          <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#A020242B" Padding="8" Margin="8"><TextBlock x:Name="DimensionsText"/></Border>
          <TextBlock x:Name="HintText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" Foreground="{DynamicResource MutedText}" Text="Importez ou déposez un fichier 3MF ou STL."/>
        </Grid>
      </Border>

      <ScrollViewer x:Name="RightPanel" Grid.Column="2" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock x:Name="ProposalsTitle" Text="4 PROPOSITIONS · 4 COULEURS" FontWeight="Bold" FontSize="16" Margin="0,0,0,8"/>
          <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel>
              <CheckBox x:Name="FunMode" Content="Motifs fun sur toute la surface" IsChecked="True" FontWeight="Bold" Checked="FunMode_Changed" Unchecked="FunMode_Changed"/>
              <TextBlock Text="Dégradé ondulé · camouflage · double personnalité · graffiti" TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="22,4,0,0"/>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="CALQUES NON DESTRUCTIFS" FontWeight="Bold"/>
              <ListBox x:Name="LayersList" Height="120" Margin="0,7,0,6" DisplayMemberPath="Name"
                       SelectionChanged="LayersList_SelectionChanged"
                       ToolTip="Sélectionnez un calque pour gérer sa visibilité, son verrouillage et son ordre."/>
              <WrapPanel>
                <Button Click="AddLayer_Click" Content="+ Calque"/>
                <Button Click="DuplicateLayer_Click" Content="Dupliquer"/>
                <Button Click="RenameLayer_Click" Content="Renommer"/>
                <Button Click="MergeLayer_Click" Content="Fusionner"/>
                <Button Click="EffectLayer_Click" Content="Effet"/>
                <Button Click="DeleteLayer_Click" Content="Supprimer"/>
                <Button Click="MoveLayerUp_Click" Content="Monter"/>
                <Button Click="MoveLayerDown_Click" Content="Descendre"/>
              </WrapPanel>
              <WrapPanel Margin="0,4,0,0">
                <CheckBox x:Name="LayerVisible" Content="Visible" IsChecked="True" Checked="LayerProperty_Changed" Unchecked="LayerProperty_Changed" Margin="0,0,12,0"/>
                <CheckBox x:Name="LayerLocked" Content="Verrouillé" Checked="LayerProperty_Changed" Unchecked="LayerProperty_Changed"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel>
              <DockPanel>
                <Button DockPanel.Dock="Right" Click="ImportPattern_Click" Content="+ Importer"/>
                <TextBlock Text="LOGOS ET IMAGES" FontWeight="Bold" VerticalAlignment="Center"/>
              </DockPanel>
              <TextBlock Text="Chaque logo reste indépendant et modifiable." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,4,0,6"/>
              <ListBox x:Name="LogoLayersList" Height="105" DisplayMemberPath="Name" SelectionChanged="LogoLayersList_SelectionChanged"/>
              <WrapPanel Margin="0,6,0,0">
                <Button Click="EditLogo_Click" Content="Modifier"/>
                <Button Click="DuplicateLogo_Click" Content="Dupliquer"/>
                <Button Click="ToggleLogo_Click" Content="Afficher/masquer"/>
                <Button Click="DeleteLogo_Click" Content="Supprimer"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="COLORATION MANUELLE" FontWeight="Bold"/>
              <CheckBox x:Name="PaintMode" Content="Sélectionner des zones sur le modèle" Checked="PaintMode_Changed" Unchecked="PaintMode_Changed" Margin="0,7,0,5"/>
              <TextBlock Text="Outil" FontSize="12" Margin="0,2,0,3"/>
              <ComboBox x:Name="PaintTool" SelectedIndex="0" Margin="0,0,0,5" SelectionChanged="PaintTool_Changed"><ComboBoxItem Content="Face par face (clic)"/><ComboBoxItem Content="Pinceau fluide (cliquer-glisser)"/><ComboBoxItem Content="Rectangle de sélection"/><ComboBoxItem Content="Lasso libre"/></ComboBox>
              <TextBlock Text="Taille du pinceau" FontSize="12" Margin="0,2,0,3"/>
              <ComboBox x:Name="PaintBrushSize" SelectedIndex="1" Margin="0,0,0,5" SelectionChanged="PaintTool_Changed"><ComboBoxItem Content="Très fin — 8 px"/><ComboBoxItem Content="Fin — 16 px"/><ComboBoxItem Content="Moyen — 28 px"/><ComboBoxItem Content="Large — 44 px"/><ComboBoxItem Content="Très large — 64 px"/></ComboBox>
              <TextBlock Text="Couleur à appliquer" FontSize="12" Margin="0,2,0,3"/><ComboBox x:Name="PaintColorCombo" DisplayMemberPath="Label" SelectedIndex="0" Margin="0,0,0,5"/>
              <TextBlock Text="Sélection intelligente" FontSize="12" FontWeight="SemiBold" Margin="0,4,0,3"/>
              <WrapPanel>
                <Button Tag="island" Click="SmartSelect_Click" Content="Îlot"/>
                <Button Tag="angle" Click="SmartSelect_Click" Content="Faces similaires"/>
                <Button Tag="color" Click="SmartSelect_Click" Content="Même couleur"/>
                <Button Tag="camera" Click="SmartSelect_Click" Content="Face caméra"/>
                <Button Tag="object" Click="SmartSelect_Click" Content="Pièce complète"/>
              </WrapPanel>
              <DockPanel Margin="0,4,0,5"><Button DockPanel.Dock="Right" Click="SemanticSelect_Click" Content="Détecter"/><ComboBox x:Name="SemanticRegionCombo" SelectedIndex="0" Margin="0,0,5,0"><ComboBoxItem Content="Yeux"/><ComboBoxItem Content="Cheveux"/><ComboBoxItem Content="Vêtements"/><ComboBoxItem Content="Peau"/><ComboBoxItem Content="Accessoires"/><ComboBoxItem Content="Socle"/><ComboBoxItem Content="Armes"/></ComboBox></DockPanel>
              <TextBlock x:Name="PaintSelectionText" Text="0 triangle sélectionné" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,0,0,5"/>
              <WrapPanel><Button Click="ApplyPaintSelection_Click" Content="Appliquer la couleur"/><Button Click="ClearPaintSelection_Click" Content="Effacer"/></WrapPanel>
            </StackPanel>
          </Border>
          <TextBlock x:Name="PatternText" Visibility="Collapsed"/>
          <ItemsControl x:Name="Proposals">
            <ItemsControl.ItemTemplate><DataTemplate>
              <Border Background="{DynamicResource PanelBackground}" BorderBrush="{DynamicResource PanelBorder}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,10" MouseDown="Proposal_Click" Tag="{Binding}">
                <StackPanel><TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryText}" FontWeight="Bold"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource SecondaryText}" FontSize="12" Margin="0,2,0,7"/>
                  <ItemsControl ItemsSource="{Binding Colors}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                    <StackPanel Width="68" Margin="0,0,5,5" ToolTipService.InitialShowDelay="200" ToolTipService.ShowDuration="10000" MouseLeftButtonDown="ProposalColor_LeftClick" MouseRightButtonDown="ProposalColor_RightClick">
                      <StackPanel.ToolTip>
                        <ToolTip>
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" Foreground="White" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Hex}" Foreground="#D9E2F0" Margin="0,2,0,0"/>
                            <TextBlock Text="Clic gauche : modifier · clic droit : désactiver" Foreground="#AFC4E6" Margin="0,5,0,0"/>
                          </StackPanel>
                        </ToolTip>
                      </StackPanel.ToolTip>
                      <Border Background="{Binding Brush}" Width="62" Height="30" CornerRadius="4"/>
                      <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" TextAlignment="Center" TextTrimming="CharacterEllipsis" Width="66"/>
                      <TextBlock Text="{Binding Hex}" FontSize="10" HorizontalAlignment="Center"/>
                    </StackPanel>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
              </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
          <CheckBox x:Name="UseFilaments" Content="Utiliser uniquement mes couleurs de filament" Checked="Filaments_Changed" Unchecked="Filaments_Changed" Margin="0,3,0,8"/>
          <Button Click="ManageFilaments_Click" Content="Gérer mes couleurs de filament…" Margin="0,0,0,8"/>
          <Button x:Name="ApplyButton" Click="Apply_Click" Content="Appliquer cette proposition" IsEnabled="False" Height="40"/>
          <TextBlock Text="Les couleurs sont inscrites sur les triangles du maillage et exportées en vraies couleurs 3MF." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryText}" Margin="0,12,0,0" FontSize="12"/>
        </StackPanel>
      </ScrollViewer>
      <Border x:Name="PatternEditorPanel"
              Grid.Column="2"
              Visibility="Collapsed"
              Background="{DynamicResource PanelBackground}"
              BorderBrush="{DynamicResource Accent}"
              BorderThickness="1"
              CornerRadius="8"
              ClipToBounds="True">
        <ContentControl x:Name="PatternEditorHost"/>
      </Border>
    </Grid>
  </DockPanel>
</Window>
