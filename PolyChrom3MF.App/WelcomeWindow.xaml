<Window x:Class="PolyChrom3MF.App.WelcomeWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Bienvenue dans PolyChrom 3MF" Width="820" Height="650" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#20242B" Foreground="White">
  <Grid><Grid.RowDefinitions><RowDefinition Height="360"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Image Source="Assets/Welcome.png" Stretch="UniformToFill"/>
      <StackPanel Grid.Row="1" Margin="28,20"><TextBlock Text="Bienvenue dans PolyChrom 3MF" FontSize="24" FontWeight="Bold"/><TextBlock Margin="0,12,0,12" TextWrapping="Wrap" Text="1. Importez un fichier 3MF ou STL.   2. Attendez l’analyse.   3. Comparez les quatre propositions.&#x0a;4. Modifiez les couleurs si nécessaire.   5. Appliquez.   6. Exportez le nouveau fichier 3MF." FontSize="15" LineHeight="26"/>
      <DockPanel><CheckBox x:Name="ShowAgain" IsChecked="True" Content="Afficher cet assistant au prochain démarrage" VerticalAlignment="Center"/><Button DockPanel.Dock="Right" Content="Commencer" IsDefault="True" Click="Close_Click" Padding="20,8" HorizontalAlignment="Right"/></DockPanel>
    </StackPanel>
  </Grid>
</Window>
