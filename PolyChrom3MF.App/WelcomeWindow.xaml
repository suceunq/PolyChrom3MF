<Window x:Class="PolyChrom3MF.App.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bienvenue dans PolyChrom 3MF"
        Width="760"
        Height="620"
        MinHeight="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize"
        Background="#20242B"
        Foreground="White">
  <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="260"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Grid>
        <Image Source="Assets/Welcome.png" Stretch="UniformToFill"/>
        <Border Background="#8A101824"/>
        <StackPanel Margin="30" VerticalAlignment="Bottom">
          <TextBlock Text="BIENVENUE" FontSize="12" FontWeight="Bold" Foreground="#FFB56B"/>
          <TextBlock Text="Merci d’utiliser PolyChrom 3MF"
                     Margin="0,5,0,0"
                     FontSize="30"
                     FontWeight="Bold"
                     TextWrapping="Wrap"/>
        </StackPanel>
      </Grid>

      <StackPanel Grid.Row="1" Margin="30,24,30,26">
        <TextBlock TextWrapping="Wrap"
                   Foreground="#D7DCE5"
                   FontSize="14"
                   LineHeight="22"
                   Text="Importez vos modèles 3MF ou STL, comparez quatre propositions multicolores, ajoutez vos motifs PNG ou JPG et exportez un fichier prêt à ouvrir dans votre slicer."/>

        <Border Margin="0,20,0,16"
                Padding="16"
                CornerRadius="10"
                Background="#302D3038"
                BorderBrush="#B26A37"
                BorderThickness="1">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="52"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="42" Height="42" CornerRadius="21" Background="#FF7A1A" VerticalAlignment="Top">
              <TextBlock Text="♥" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" FontSize="18" FontWeight="Bold"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
              <TextBlock Text="Soutenir le projet" FontWeight="Bold" FontSize="15"/>
              <TextBlock Margin="0,5,0,0"
                         TextWrapping="Wrap"
                         Foreground="#D7DCE5"
                         LineHeight="20"
                         Text="Si PolyChrom 3MF vous est utile, un don aide à financer son développement, ses améliorations, ses tests et sa maintenance."/>
            </StackPanel>
          </Grid>
        </Border>

        <CheckBox x:Name="ShowAgain"
                  IsChecked="True"
                  Content="Afficher cette fenêtre au démarrage"
                  Foreground="#C7CFDB"
                  Margin="2,0,0,16"/>

        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="190"/>
          </Grid.ColumnDefinitions>
          <Button Grid.Column="0"
                  Content="♥  Faire un don avec PayPal"
                  Click="Donate_Click"
                  IsDefault="True"
                  MinHeight="46"
                  FontWeight="Bold"
                  FontSize="14"
                  Foreground="White"
                  Background="#FF7A1A"
                  BorderBrush="#FF8F3A"/>
          <Button Grid.Column="2"
                  Content="Plus tard"
                  Click="Close_Click"
                  MinHeight="46"
                  FontWeight="SemiBold"/>
        </Grid>
      </StackPanel>
    </Grid>
  </ScrollViewer>
</Window>
