<Window x:Class="PolyChrom3MF.App.WhatsNewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nouveautés de PolyChrom 3MF"
        Width="700"
        Height="570"
        MinWidth="580"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        Background="#20242B"
        Foreground="White">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="190"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid>
      <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#7A4326" Offset="0"/>
          <GradientStop Color="#2746B8" Offset="0.48"/>
          <GradientStop Color="#078BC6" Offset="1"/>
        </LinearGradientBrush>
      </Grid.Background>
      <Ellipse Width="250" Height="250" Fill="#18FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-95,-45,0"/>
      <Ellipse Width="170" Height="170" Fill="#12FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-55,0,0,-100"/>
      <Grid Margin="28">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="105"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="86" Height="86" CornerRadius="20" Background="#D8151B25" BorderBrush="#70FFFFFF" BorderThickness="1">
          <Image Source="Assets/PolyChrom_icon.png" Stretch="Uniform" Margin="9"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0">
          <TextBlock Text="MISE À JOUR INSTALLÉE" FontSize="12" FontWeight="Bold" Foreground="#FFE0A6"/>
          <TextBlock Text="Découvrez les nouveautés" FontSize="28" FontWeight="Bold" Margin="0,5,0,4"/>
          <TextBlock x:Name="VersionText" FontSize="16" FontWeight="SemiBold" Foreground="#E8EEF9"/>
        </StackPanel>
      </Grid>
    </Grid>

    <Grid Grid.Row="1" Margin="28,24,28,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>
      <TextBlock Text="Ce qui a changé" FontSize="20" FontWeight="Bold" Margin="0,0,0,14"/>
      <Border Grid.Row="1" Padding="18,12" CornerRadius="10" Background="#2B313C" BorderBrush="#566277" BorderThickness="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="NotesPanel"/>
        </ScrollViewer>
      </Border>
      <Grid Grid.Row="2" Margin="0,18,0,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="185"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="190"/>
        </Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="♥  Soutenir le projet" Click="Donate_Click" MinHeight="44" FontWeight="Bold" Foreground="White" Background="#F47721" BorderBrush="#FF9A54"/>
        <TextBlock Grid.Column="1" Text="Merci d’utiliser PolyChrom 3MF." Foreground="#C2CAD6" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="12,0"/>
        <Button Grid.Column="2" Content="C’est parti !" Click="Close_Click" IsDefault="True" MinHeight="44" FontWeight="Bold" FontSize="14" Background="#187FD1" BorderBrush="#58AFFF"/>
      </Grid>
    </Grid>
  </Grid>
</Window>
